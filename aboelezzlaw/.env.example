# ════════════════════════════════════════════════════════════════
#  مكتب أبو العز للمحاماة — متغيّرات البيئة
#  انسخ هذا الملف إلى .env.local للتشغيل المحلي،
#  وأضف نفس القيم في Vercel ▸ Settings ▸ Environment Variables للنشر.
#  ⚠️ لا ترفع .env.local إلى GitHub إطلاقاً — هو مستثنى في .gitignore.
# ════════════════════════════════════════════════════════════════

# ───────────── 1) إشعارات البريد (مطلوب) ─────────────
# اختر واحداً فقط من المسارين:

# المسار (أ) — Resend: الأسهل. سجّل على resend.com واحصل على مفتاح مجاني.
RESEND_API_KEY=
# المُرسِل. قبل توثيق نطاقك استخدم onboarding@resend.dev
MAIL_FROM="Abo Elezz Law <onboarding@resend.dev>"

# المسار (ب) — SMTP: عبر Gmail أو بريد Hostinger.
# لجيميل: فعّل التحقق بخطوتين ثم أنشئ "كلمة مرور تطبيق" واستخدمها هنا (لا كلمة مرور حسابك).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ───────────── 2) إشعارات واتساب (اختياري لكنه موصى به) ─────────────
# يُختار أول مزوّد مضبوط. الرقم المستقبِل مضبوط في src/content/site.ts

# (أ) UltraMsg — الأنسب عملياً في مصر: يرسل رسائل نصية حرّة بلا قوالب معتمدة.
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# (ب) WhatsApp Cloud API الرسمي من Meta.
# ملاحظة: الرسائل التي تبدأ من الشركة تحتاج قالباً معتمداً — اضبط اسم القالب.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# (ج) Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ───────────── 3) إشعار تيليجرام (مجاني تماماً — قناة احتياطية ممتازة) ─────────────
# أنشئ بوتاً عبر @BotFather ثم أرسل له رسالة، واحصل على chat_id من:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───────────── 4) قاعدة البيانات (لازمة للوحة تحكم العميل وسجلّ الطلبات) ─────────────
# بدونها يظل الموقع يعمل وتصلك كل الإشعارات، لكن تختفي لوحة الحساب وسجلّ الطلبات
# ومنع الحجز المزدوج وتتبّع الاشتراكات.
#
# أسهل خيار مجاني: neon.tech ← أنشئ مشروعاً ← انسخ Connection String (Pooled).
# على Vercel يمكن ربطها بنقرة من Storage ▸ Create Database ▸ Neon.
# الجداول تُنشأ تلقائياً عند أول طلب — لا هجرات يدوية.
DATABASE_URL=

# مفتاح توقيع جلسات العملاء. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# لا تستخدم نفس قيمة DOWNLOAD_SECRET في الإنتاج.
AUTH_SECRET=

# ───────────── 5) محرّك تجديد الاشتراكات (Vercel Cron) ─────────────
# سرّ يحمي مسار /api/cron/subscriptions من التشغيل من الخارج.
# ولّده بنفس الأمر أعلاه. الجدولة معرّفة في vercel.json (يومياً 6:00 صباحاً UTC).
CRON_SECRET=

# ───────────── 6) بوابة Paymob (بعد اعتماد حسابك) ─────────────
# Dashboard ▸ Settings ▸ API Keys
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# أرقام التكاملات مفصولة بفواصل (بطاقة، محفظة، ...)
PAYMOB_INTEGRATION_IDS=
# للتحقق من صحة إشعارات الـ webhook
PAYMOB_HMAC_SECRET=

# ───────────── 7) PayPal ─────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox للتجربة، live للإنتاج
PAYPAL_ENV=sandbox
# باي بال لا يدعم الجنيه المصري — نحوّل إلى USD
PAYPAL_CURRENCY=USD
# سعر تحويل الجنيه إلى عملة باي بال — حدّثه دورياً
PAYPAL_EGP_RATE=50

# خطط الاشتراك المتكرّر: تُنشأ أولاً في لوحة PayPal (Products ▸ Plans)
# ثم تُربط بمنتجات المتجر هنا. بدونها تُباع الباقات كدفعة واحدة
# ويتولّى محرّك التذكيرات تنبيه العميل قبل انتهاء دورته.
# مثال: {"package-basic":"P-1AB...","package-business":"P-2CD...","package-premium":"P-3EF..."}
PAYPAL_PLANS=

# ───────────── 8) الدفع اليدوي (يعمل فوراً بلا أي حساب بوابة) ─────────────
# يُعرض نصّه كما هو للعميل بعد تأكيد الطلب.
BANK_TRANSFER_DETAILS="البنك: ................  |  اسم الحساب: ................  |  رقم الحساب: ................  |  IBAN: ................"
INSTAPAY_ADDRESS="................@instapay"
WISE_DETAILS="الاسم: ................  |  البريد المرتبط بالحساب: ................"
WALLET_NUMBER="01157844664 (فودافون كاش)"

# ───────────── 9) تسليم المنتجات الرقمية (مطلوب لبيع الملفات) ─────────────
# مفتاح عشوائي طويل لتوقيع روابط التحميل. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SECRET=
# اختياري: لو رفعت الملفات على تخزين خارجي (R2 / S3 / Bunny) بدل مجلد private/downloads
DOWNLOAD_BASE_URL=

# ───────────── 10) اليوتيوب ─────────────
# اختياري: يجعل جلب الفيديوهات أسرع وأوثق.
# للحصول عليه: افتح القناة ▸ عرض مصدر الصفحة ▸ ابحث عن "channelId"
YOUTUBE_CHANNEL_ID=
